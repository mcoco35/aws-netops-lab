# Copy to terraform.tfvars to override defaults. terraform.tfvars is gitignored.
# The defaults already build a working lab in us-east-1 with NAT disabled.

aws_region           = "us-east-1"
environment          = "lab"
name_prefix          = "netops-lab"
availability_zones   = ["us-east-1a", "us-east-1b"]
hub_cidr             = "10.0.0.0/16"
spoke_a_cidr         = "10.1.0.0/16"
spoke_b_cidr         = "10.2.0.0/16"
enable_nat_gateway   = false
single_nat_gateway   = true
allow_spoke_to_spoke = false
amazon_side_asn      = 64512
